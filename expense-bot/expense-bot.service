# VPS учун: sudo cp expense-bot.service /etc/systemd/system/ && sudo systemctl enable --now expense-bot
[Unit]
Description=Fast-food accounting Telegram bot
After=network-online.target

[Service]
WorkingDirectory=/opt/expense-bot
ExecStart=/opt/expense-bot/.venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
