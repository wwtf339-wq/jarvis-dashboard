# ===== MAJBURIY =====
# @BotFather -> /newbot -> bergan token
TELEGRAM_BOT_TOKEN=
# https://aistudio.google.com/apikey -> "Create API key" (bepul)
GEMINI_API_KEY=
# Xo'jayinlarning Telegram ID lari, vergul bilan (ID ni @userinfobot ko'rsatadi).
# Birinchisi — asosiy xo'jayin (haftalik zahira nusxa unga keladi).
OWNER_IDS=

# ===== IXTIYORIY =====
# Asosiy model va zaxiralar. Bepul tarifda har bir modelga kuniga ~20 so'rov beriladi,
# biri tugasa bot keyingisiga o'tadi. Mavjud modellar ro'yxati: README dagi buyruq.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3.6-flash
# Pullik zaxira (ixtiyoriy): bepul limit tugasa bot avtomatik shu kalitga o'tadi.
# Kalit billing ulangan ALOHIDA loyihadan bo'lsin (bepul kalit loyihasiga billing ulamang).
GEMINI_PAID_API_KEY=
GEMINI_PAID_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
MAX_OWNERS=3
TIMEZONE=Asia/Tashkent
DB_PATH=expenses.db
# Shu soatgacha bo'lgan yozuv oldingi kunga tushadi (kechasi yopiladigan tochkalar uchun)
DAY_START_HOUR=5
SALES_REMINDER_TIME=23:30
DIGEST_TIME=09:00
# 0=dushanba ... 6=yakshanba
BACKUP_WEEKDAY=6
BACKUP_TIME=10:00
NOTIFY_OWNERS_ON_SALES=1
# Kuniga nechta smena (kirim smena bo'yicha yoziladi)
SHIFTS=2
