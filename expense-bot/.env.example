# ===== МАЖБУРИЙ =====
# @BotFather -> /newbot -> берган токен
TELEGRAM_BOT_TOKEN=
# https://aistudio.google.com/apikey -> "Create API key" (бепул)
GEMINI_API_KEY=
# Хўжайинларнинг Telegram ID лари, вергул билан (ID ни @userinfobot кўрсатади).
# Биринчиси — асосий хўжайин (ҳафталик заҳира нусха унга келади).
OWNER_IDS=

# ===== ИХТИЁРИЙ =====
# "gemini-flash-latest" — Google ўзи энг янги Flash га улайди. Аниқ версия керак бўлса
# AI Studio даги рўйхатдан номини ёзинг.
GEMINI_MODEL=gemini-flash-latest
MAX_OWNERS=3
TIMEZONE=Asia/Tashkent
DB_PATH=expenses.db
# Шу соатгача бўлган ёзув олдинги кунга тушади (кечаси ёпиладиган точкалар учун)
DAY_START_HOUR=5
SALES_REMINDER_TIME=23:30
DIGEST_TIME=09:00
# 0=душанба ... 6=якшанба
BACKUP_WEEKDAY=6
BACKUP_TIME=10:00
NOTIFY_OWNERS_ON_SALES=1
