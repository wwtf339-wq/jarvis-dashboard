# ===== MAJBURIY =====
# @BotFather -> /newbot -> bergan token
TELEGRAM_BOT_TOKEN=
# https://aistudio.google.com/apikey -> "Create API key" (bepul)
GEMINI_API_KEY=
# Xo'jayinlarning Telegram ID lari, vergul bilan (ID ni @userinfobot ko'rsatadi).
# Birinchisi — asosiy xo'jayin (haftalik zahira nusxa unga keladi).
OWNER_IDS=

# ===== IXTIYORIY =====
# Asosiy model va zaxiralar (birinchisi band bo'lsa, keyingisi ishlatiladi)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-2.5-flash
MAX_OWNERS=3
TIMEZONE=Asia/Tashkent
DB_PATH=expenses.db
# Shu soatgacha bo'lgan yozuv oldingi kunga tushadi (kechasi yopiladigan tochkalar uchun)
DAY_START_HOUR=5
SALES_REMINDER_TIME=23:30
DIGEST_TIME=09:00
# 0=dushanba ... 6=yakshanba
BACKUP_WEEKDAY=6
BACKUP_TIME=10:00
NOTIFY_OWNERS_ON_SALES=1
